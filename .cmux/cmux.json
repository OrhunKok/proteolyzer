{
  "commands": [
    {
      "name": "Open sandbox",
      "description": "a workspace with Claude and a shell, both already in the container",
      "keywords": ["devcontainer", "sandbox", "claude", "open", "reopen"],
      "workspace": {
        "cwd": ".",
        "layout": {
          "direction": "horizontal",
          "split": 0.6,
          "children": [
            {
              "pane": {
                "surfaces": [
                  {
                    "type": "terminal",
                    "name": "claude",
                    "command": "./.devcontainer/up.sh claude --dangerously-skip-permissions",
                    "focus": true
                  }
                ]
              }
            },
            {
              "pane": {
                "surfaces": [
                  {
                    "type": "terminal",
                    "name": "shell",
                    "command": "./.devcontainer/up.sh"
                  }
                ]
              }
            }
          ]
        }
      }
    },
    {
      "name": "Open sandbox (cmux ssh)",
      "description": "same, over ssh — durable terminals and the cmux CLI inside",
      "keywords": ["devcontainer", "sandbox", "ssh", "workspace"],
      "command": "cd \"$(git rev-parse --show-toplevel)\" && ./.devcontainer/cmux-attach.sh claude --dangerously-skip-permissions"
    },
    {
      "name": "Devcontainer shell",
      "description": "one shell in the sandbox, in this pane",
      "keywords": ["devcontainer", "shell", "zsh"],
      "command": "cd \"$(git rev-parse --show-toplevel)\" && ./.devcontainer/up.sh"
    },
    {
      "name": "Rebuild devcontainer",
      "description": "rebuild the image from the Dockerfile, then replace the container",
      "keywords": ["rebuild", "devcontainer", "image", "build"],
      "command": "cd \"$(git rev-parse --show-toplevel)\" && ./.devcontainer/build.sh && REBUILD=1 ./.devcontainer/up.sh",
      "confirm": true
    }
  ]
}
