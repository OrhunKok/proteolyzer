// The whole of a project's sandbox configuration. Everything else -- the image,
// the firewall, sshd, the host-side scripts -- lives in the claude-devcontainer
// repository, which is installed once on this Mac rather than copied in here.
//
// Written by `sandbox init`. Edit freely: this file is the project's, and the
// three keys below are where a project is *supposed* to diverge.
{
  // The project, which becomes the container name and its DNS hostname. Keep
  // the folder name lowercase and DNS-safe.
  "name": "${localWorkspaceFolderBasename}",

  // Built by `sandbox build`, once per machine -- every project runs the same
  // image, and nothing in it is project-specific.
  "image": "claude-devcontainer:local",

  // DIVERGE HERE. A project's own toolchain belongs in `features`, which is the
  // devcontainer spec's own mechanism for it and is pinned by
  // devcontainer-lock.json once resolved.
  "features": {
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.14",
      "installTools": false
    }
  },

  // NET_ADMIN is for init-firewall.sh, which needs iptables and ipset.
  // `capAdd` rather than `runArgs`, which adevcontainer rejects.
  //
  // SYS_RESOURCE is for start-sshd.sh, and it is not optional there: lowering a
  // process's oom_score_adj below zero requires it, and Apple `container` does
  // not grant it -- the default bounding set is 0xa80435fb, which has NET_ADMIN
  // and NET_RAW and not this. Without it the write failed as root and silently,
  // leaving the sshd listener exactly as killable as the work it protects, which
  // is what takes ssh down for good when memory runs out.
  "capAdd": ["NET_ADMIN", "SYS_RESOURCE"],

  "remoteUser": "node",
  "workspaceFolder": "/workspace",

  // `container create -c` and `-m`, and the two are not the same kind of thing.
  // Sized for an 18 GB Mac; the long form is in claude-devcontainer's
  // docs/the-sandbox.md#ceilings.
  //
  // `cpus` is a real burst ceiling: it lands as a cgroup quota, so the container
  // may use up to it and costs the Mac nothing while idle.
  //
  // `memory` is not. It sizes the VM as well as the cgroup, and with no
  // virtio-balloon device on it the guest cannot hand a page back -- Linux keeps
  // what it touched as page cache, so host memory ratchets up toward this number
  // and is released when the container stops, not when the work finishes. 14 of
  // 18 GB is a deliberate choice: one container at a time.
  //
  // Both are checked against the Mac's *physical* RAM and core count rather than
  // what is free, and a shortfall is a hard failure -- `up` refuses with "host
  // has less memory than required" instead of starting something smaller.
  "hostRequirements": { "cpus": 10, "memory": "14gb" },

  // One volume per project, keyed on the folder name, holding everything that
  // must survive a rebuild: Claude's config and history, the gh login, the git
  // identity, the shell history.
  "mounts": [
    "source=claude-code-state-${localWorkspaceFolderBasename},target=/home/node/.state,type=volume"
  ],

  // Once per container, which is exactly when it is needed: the Python
  // environment lives in the image, not on the state volume, so a rebuild wipes
  // it -- numpy, ruff and pytest all vanish and `make test` fails on a container
  // that was working an hour ago. `;` rather than `&&` so pip runs either way,
  // and its exit code is the command's, so a failure is reported rather than
  // discovered later.
  //
  // This belongs here and not in a frontend's per-worktree setup script: the
  // environment is per *container*, shared by every worktree in it, and a
  // per-worktree `pip install -e .` would repoint the editable install at that
  // worktree and silently change what every other one imports.
  "postCreateCommand": "grep -q gh-auth.sh ~/.zshrc || echo 'source /usr/local/share/sandbox/gh-auth.sh' >> ~/.zshrc; pip install -e '.[dev,unimod]'",
  // Order matters: fix-volume-perms.sh first, because Apple `container` does not
  // seed a named volume from the image (apple/container#729); then the firewall,
  // which flushes the tables, so sshd starts after it.
  "postStartCommand": "sudo /usr/local/bin/fix-volume-perms.sh && sudo /usr/local/bin/init-firewall.sh && sudo /usr/local/bin/start-sshd.sh",
  "waitFor": "postStartCommand"
}
