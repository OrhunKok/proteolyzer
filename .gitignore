# Repositories downstream of this one, checked out here so a core change can be
# made and tested against them in one place. Each is its own git repo; none of
# it belongs to this one. See downstream/README.md.
/downstream/

# `.devcontainer/state.sh export` writes here: the named volumes this container
# keeps, so they can be carried to another machine. With --with-credentials it
# holds a GitHub token in plaintext. Never committed.
/devcontainer-state.tar.gz

# `state.sh adopt` stages here for the length of one copy and removes it on the
# way out. Ignored because a killed run would otherwise leave a directory
# holding a credential sitting in `git status`.
/.state-adopt/
